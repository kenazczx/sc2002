"26.0" width="366.0" height="24.0" as="geometry"/></mxCell><mxCell id="c144" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];connectable=0;strokeColor=#D6B656;" vertex="1" parent="c141"><mxGeometry x="0.0" y="46.0" width="366.0" height="8.0" as="geometry"/></mxCell><mxCell id="c145" value="&lt;div style=&quot;line-height:14px&quot;&gt;+ RegularCustomer(id: int, name: String, arrivalTurn: int, tasteIndex: int)&lt;br&gt;+ getSatisfactionLossPerWaitingTurn(): int&lt;br&gt;+ getTypeLabel(): String&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c141"><mxGeometry x="0.0" y="50.0" width="366.0" height="52.0" as="geometry"/></mxCell><mxCell id="c146" value="Money" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=26;collapsible=0;container=1;marginBottom=0;whiteSpace=nowrap;fillColor=#FFF2CC;swimlaneFillColor=#FFFFFF;swimlaneLine=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40.0" y="2655.0" width="206.0" height="88.0" as="geometry"/></mxCell><mxCell id="c147" value="" style="shape=umlEntity;html=1;fillColor=none;strokeColor=#333333;strokeWidth=1.2;connectable=0;" vertex="1" parent="c146"><mxGeometry x="188.0" y="7.0" width="12.0" height="12.0" as="geometry"/></mxCell><mxCell id="c148" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c146"><mxGeometry x="0.0" y="26.0" width="206.0" height="10.0" as="geometry"/></mxCell><mxCell id="c149" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];connectable=0;strokeColor=#D6B656;" vertex="1" parent="c146"><mxGeometry x="0.0" y="32.0" width="206.0" height="8.0" as="geometry"/></mxCell><mxCell id="c150" value="&lt;div style=&quot;line-height:14px&quot;&gt;- Money()&lt;br&gt;&lt;u&gt;+ percentOf(cents: int, percent: int): int&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ format(cents: int): String&lt;/u&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c146"><mxGeometry x="0.0" y="36.0" width="206.0" height="52.0" as="geometry"/></mxCell><mxCell id="c151" value="&lt;b&gt;Polymorphism (interfaces)&lt;/b&gt;&lt;br&gt;GameController holds only the&lt;br&gt;ManagerInput and GameDisplay&lt;br&gt;interfaces. ConsoleUI implements&lt;br&gt;both for live play and ScriptedInput&lt;br&gt;implements ManagerInput to replay a&lt;br&gt;recorded run, so the same&lt;br&gt;input.askCommand(...) call reaches&lt;br&gt;either one." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1730.0" y="130.0" width="196.0" height="133.0" as="geometry"/></mxCell><mxCell id="c152" value="&lt;b&gt;Encapsulation&lt;/b&gt;&lt;br&gt;Every field is private and there are no setters.&lt;br&gt;lockedPriceCents is final: the price is fixed when the order&lt;br&gt;is taken. status changes only through advancePreparation,&lt;br&gt;markServed, markPaid and cancel, and each one throws&lt;br&gt;IllegalStateException when called out of order." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="560.0" y="2863.0" width="290.0" height="94.0" as="geometry"/></mxCell><mxCell id="c153" value="&lt;b&gt;Composition&lt;/b&gt;&lt;br&gt;Restaurant creates its Tables (from tableCount) and its&lt;br&gt;WaitingQueue itself, so they exist only inside it: filled&lt;br&gt;diamonds. The Menu and the three staff members are&lt;br&gt;created in RestaurantRush and passed to the constructor,&lt;br&gt;which makes those aggregations: hollow diamonds." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1440.0" y="2169.0" width="300.0" height="94.0" as="geometry"/></mxCell><mxCell id="c154" value="&lt;b&gt;Polymorphism&lt;/b&gt;&lt;br&gt;Customer is abstract. applyWaitingLoss() calls the abstract&lt;br&gt;getSatisfactionLossPerWaitingTurn(), which RegularCustomer&lt;br&gt;implements (8 a turn); chooseFrom(Menu),&lt;br&gt;applyCustomerDiscount(int) and satisfactionToRecord() are&lt;br&gt;defaults a subclass may override. A new kind of customer is&lt;br&gt;therefore a new subclass, with no change to the classes that&lt;br&gt;use Customer." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1716.0" y="3375.0" width="300.0" height="120.0" as="geometry"/></mxCell><mxCell id="c155" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;exitX=0.4054;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.1142;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c4" target="c31"><mxGeometry relative="1" as="geometry"><mxPoint x="100.0" y="204.0" as="sourcePoint"/><mxPoint x="540.0" y="450.0" as="targetPoint"/><Array as="points"><mxPoint x="100.0" y="450.0"/></Array></mxGeometry></mxCell><mxCell id="c156" value="&lt;i&gt;«instantiate»&lt;/i&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontFamily=Helvetica;fontColor=#333333;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c155"><mxGeometry x="0.3586" relative="1" as="geometry"><mxPoint x="0.0" y="-9.5" as="offset"/></mxGeometry></mxCell><mxCell id="c157" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;exitX=0.0000;exitY=0.0457;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4981;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c31" target="c8"><mxGeometry relative="1" as="geometry"><mxPoint x="540.0" y="420.0" as="sourcePoint"/><mxPoint x="362.0" y="274.0" as="targetPoint"/><Array as="points"><mxPoint x="362.0" y="420.0"/></Array></mxGeometry></mxCell><mxCell id="c158" value="&lt;i&gt;«use»&lt;/i&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontFamily=Helvetica;fontColor=#333333;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c157"><mxGeometry x="-0.4506" relative="1" as="geometry"><mxPoint x="0.0" y="-9.5" as="offset"/></mxGeometry></mxCell><mxCell id="c159" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6