="575.0" width="22.0" height="17.0" as="geometry"/></mxCell><mxCell id="c310" value="app" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2111.0" y="578.0" width="52.0" height="14.0" as="geometry"/></mxCell><mxCell id="c311" value="RestaurantRush (package app) only creates the objects and starts" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="591.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c312" value="the game, so it has no stereotype." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="604.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c313" value="Stage 1 is the starting design, so no class is marked new." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="618.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c314" value="&lt;b&gt;Members&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1848.0" y="642.0" width="314.0" height="15.0" as="geometry"/></mxCell><mxCell id="c315" value="Visibility: + public, - private, # protected, ~ package. Underlined:" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="656.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c316" value="static. Italic with {abstract}: abstract." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="669.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c317" value="Attribute: name: type = initial value" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="682.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c318" value="Operation: name(parameter: type): return type" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="695.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c319" value="Constructor: the class name, and no return type" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="708.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c320" value="Every field, constructor and method declared in the code is listed." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="721.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c321" value="{...} after an attribute is a constraint the class keeps." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="734.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c322" value="Role names on the lines are the Java field names. {ordered}: the field" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="747.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c323" value="is a List, so it keeps its order." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="760.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c324" value="&lt;b&gt;Dependencies left out to keep lines apart&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1848.0" y="784.0" width="314.0" height="15.0" as="geometry"/></mxCell><mxCell id="c325" value="RestaurantRush creates and wires every object; only its «instantiate»" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="798.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c326" value="of GameController is drawn." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="811.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c327" value="ArrivalSchedule creates the RegularCustomer objects that it returns" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="824.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c328" value="as Customer." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="837.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c329" value="Money (static helpers for cents) is used by MenuItem, Order," style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="850.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c330" value="GameController and ConsoleUI." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="863.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c331" value="Any other parameter or return type can be read in the operation" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="876.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c332" value="signatures." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1850.0" y="889.0" width="312.0" height="14.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>