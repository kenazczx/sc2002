l><mxCell id="c303" value="ArrivalSchedule creates the RegularCustomer, VIPCustomer and" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1710.0" y="644.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c304" value="CriticCustomer that it returns as Customer." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1710.0" y="657.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c305" value="Money (static helpers for cents) is used by MenuItem, Order," style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1710.0" y="670.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c306" value="VIPCustomer, GameController and ConsoleUI." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1710.0" y="683.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c307" value="Any other parameter or return type can be read in the operation" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1710.0" y="696.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c308" value="signatures." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1710.0" y="709.0" width="312.0" height="14.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>