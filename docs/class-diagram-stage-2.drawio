 id="c123" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;u&gt;+ SATISFACTION_LOSS: int = 5&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ BILL_PERCENT: int = 90&lt;/u&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c122"><mxGeometry x="0.0" y="26.0" width="224.0" height="38.0" as="geometry"/></mxCell><mxCell id="c124" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];connectable=0;strokeColor=#D6B656;" vertex="1" parent="c122"><mxGeometry x="0.0" y="60.0" width="224.0" height="8.0" as="geometry"/></mxCell><mxCell id="c125" value="&lt;div style=&quot;line-height:14px&quot;&gt;+ getSatisfactionLossPerWaitingTurn(): int&lt;br&gt;+ getTypeLabel(): String&lt;br&gt;+ applyCustomerDiscount(int): int&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c122"><mxGeometry x="0.0" y="64.0" width="224.0" height="52.0" as="geometry"/></mxCell><mxCell id="c126" value="CriticCustomer" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=26;collapsible=0;container=1;marginBottom=0;whiteSpace=nowrap;fillColor=#FFF2CC;swimlaneFillColor=#FFFFFF;swimlaneLine=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;strokeColor=#D79B00;strokeWidth=2.6;" vertex="1" parent="1"><mxGeometry x="1538.0" y="2585.0" width="224.0" height="158.0" as="geometry"/></mxCell><mxCell id="c127" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;u&gt;+ SATISFACTION_LOSS: int = 12&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ PROMPT_SERVICE_TURNS: int = 3&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ REVIEW_SWING: int = 10&lt;/u&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c126"><mxGeometry x="0.0" y="26.0" width="224.0" height="52.0" as="geometry"/></mxCell><mxCell id="c128" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];connectable=0;strokeColor=#D6B656;" vertex="1" parent="c126"><mxGeometry x="0.0" y="74.0" width="224.0" height="8.0" as="geometry"/></mxCell><mxCell id="c129" value="&lt;div style=&quot;line-height:14px&quot;&gt;+ getSatisfactionLossPerWaitingTurn(): int&lt;br&gt;+ getTypeLabel(): String&lt;br&gt;+ chooseFrom(Menu): MenuItem&lt;br&gt;+ satisfactionToRecord(): int&lt;br&gt;+ wroteFavourableReview(): boolean&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c126"><mxGeometry x="0.0" y="78.0" width="224.0" height="80.0" as="geometry"/></mxCell><mxCell id="c130" value="&lt;b&gt;Polymorphism (interfaces)&lt;/b&gt;&lt;br&gt;GameController holds only the&lt;br&gt;ManagerInput and GameDisplay&lt;br&gt;interfaces. ConsoleUI implements&lt;br&gt;both for live play and ScriptedInput&lt;br&gt;implements ManagerInput to replay a&lt;br&gt;recorded run, so the same&lt;br&gt;input.askCommand(...) call reaches&lt;br&gt;either one." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1490.0" y="130.0" width="196.0" height="133.0" as="geometry"/></mxCell><mxCell id="c131" value="&lt;b&gt;Encapsulation&lt;/b&gt;&lt;br&gt;Every field is private and there are no setters.&lt;br&gt;lockedPriceCents is final: the price is fixed when the order&lt;br&gt;is taken. status changes only through advancePreparation,&lt;br&gt;markServed, markPaid and cancel, and each one throws&lt;br&gt;IllegalStateException when called out of order." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="680.0" y="2158.0" width="290.0" height="94.0" as="geometry"/></mxCell><mxCell id="c132" value="&lt;b&gt;Composition&lt;/b&gt;&lt;br&gt;Restaurant creates its Tables and its WaitingQueue in its own&lt;br&gt;constructor, so they exist only inside it. The Menu and the&lt;br&gt;three staff members are created in RestaurantRush and&lt;br&gt;passed in, which makes those aggregations." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1700.0" y="1688.0" width="300.0" height="81.0" as="geometry"/></mxCell><mxCell id="c133" value="&lt;b&gt;Polymorphism&lt;/b&gt;&lt;br&gt;createOrderFor(...) asks the customer rather than testing its&lt;br&gt;type: customer.chooseFrom(menu) and&lt;br&gt;customer.applyCustomerDiscount(price) are bound at run&lt;br&gt;time, so a CriticCustomer picks the most demanding dish and&lt;br&gt;a VIPCustomer gets 10% off." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="230.0" y="928.0" width="300.0" height="94.0" as="geometry"/></mxCell><mxCell id="c134" value="&lt;b&gt;Polymorphism&lt;/b&gt;&lt;br&gt;Customer.applyWaitingLoss() calls the abstract&lt;br&gt;getSatisfactionLossPerWaitingTurn(), so each&lt;br&gt;subclass loses its own amount per turn (8, 5,&lt;br&gt;12). CriticCustomer also overrides&lt;br&gt;chooseFrom(Menu) and satisfactionToRecord()." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1800.0" y="2585.0" width="240.0" height="94.0" as="geometry"/></mxCell><mxCell id="c135" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;exitX=0.4959;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.1220;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c4" target="c26"><mxGeometry relative="1" as="geometry"><mxPoint x="100.0" y="204.0" as="sourcePoint"/><mxPoint x="442.0" y="370.0" as="targetPoint"/><Array as="points"><mxPoint x="100.0" y="370.0"/></Array></mxGeometry></mxCell><mxCell id="c136" value="&lt;i&gt;«create»&lt;/i&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontFamily=Helvetica;fontColor=#333333;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c135"><mxGeometry x="0.3268" relative="1" as="geometry"><mxPoint x="0.0" y="-9.5" as="offset"/></mxGeometry></mxCell><mxCell id="c137" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;exitX=0.0000;exitY=0.0488;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4938;entryY=1.0000;e