yle=&quot;line-height:14px&quot;&gt;&lt;u&gt;+ SATISFACTION_LOSS: int = 8&lt;/u&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c140"><mxGeometry x="0.0" y="26.0" width="224.0" height="24.0" as="geometry"/></mxCell><mxCell id="c142" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];connectable=0;strokeColor=#D6B656;" vertex="1" parent="c140"><mxGeometry x="0.0" y="46.0" width="224.0" height="8.0" as="geometry"/></mxCell><mxCell id="c143" value="&lt;div style=&quot;line-height:14px&quot;&gt;+ getSatisfactionLossPerWaitingTurn(): int&lt;br&gt;+ getTypeLabel(): String&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c140"><mxGeometry x="0.0" y="50.0" width="224.0" height="38.0" as="geometry"/></mxCell><mxCell id="c144" value="VIPCustomer" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=26;collapsible=0;container=1;marginBottom=0;whiteSpace=nowrap;fillColor=#FFF2CC;swimlaneFillColor=#FFFFFF;swimlaneLine=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1284.0" y="2705.0" width="224.0" height="116.0" as="geometry"/></mxCell><mxCell id="c145" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;u&gt;+ SATISFACTION_LOSS: int = 5&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ BILL_PERCENT: int = 90&lt;/u&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c144"><mxGeometry x="0.0" y="26.0" width="224.0" height="38.0" as="geometry"/></mxCell><mxCell id="c146" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];connectable=0;strokeColor=#D6B656;" vertex="1" parent="c144"><mxGeometry x="0.0" y="60.0" width="224.0" height="8.0" as="geometry"/></mxCell><mxCell id="c147" value="&lt;div style=&quot;line-height:14px&quot;&gt;+ getSatisfactionLossPerWaitingTurn(): int&lt;br&gt;+ getTypeLabel(): String&lt;br&gt;+ applyCustomerDiscount(int): int&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c144"><mxGeometry x="0.0" y="64.0" width="224.0" height="52.0" as="geometry"/></mxCell><mxCell id="c148" value="CriticCustomer" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=26;collapsible=0;container=1;marginBottom=0;whiteSpace=nowrap;fillColor=#FFF2CC;swimlaneFillColor=#FFFFFF;swimlaneLine=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1538.0" y="2705.0" width="224.0" height="144.0" as="geometry"/></mxCell><mxCell id="c149" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;u&gt;+ SATISFACTION_LOSS: int = 12&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ PROMPT_SERVICE_TURNS: int = 3&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ REVIEW_SWING: int = 10&lt;/u&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c148"><mxGeometry x="0.0" y="26.0" width="224.0" height="52.0" as="geometry"/></mxCell><mxCell id="c150" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];connectable=0;strokeColor=#D6B656;" vertex="1" parent="c148"><mxGeometry x="0.0" y="74.0" width="224.0" height="8.0" as="geometry"/></mxCell><mxCell id="c151" value="&lt;div style=&quot;line-height:14px&quot;&gt;+ getSatisfactionLossPerWaitingTurn(): int&lt;br&gt;+ getTypeLabel(): String&lt;br&gt;+ chooseFrom(Menu): MenuItem&lt;br&gt;+ satisfactionToRecord(): int&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c148"><mxGeometry x="0.0" y="78.0" width="224.0" height="66.0" as="geometry"/></mxCell><mxCell id="c152" value="Money" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=26;collapsible=0;container=1;marginBottom=0;whiteSpace=nowrap;fillColor=#FFF2CC;swimlaneFillColor=#FFFFFF;swimlaneLine=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40.0" y="1960.0" width="132.0" height="74.0" as="geometry"/></mxCell><mxCell id="c153" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c152"><mxGeometry x="0.0" y="26.0" width="132.0" height="10.0" as="geometry"/></mxCell><mxCell id="c154" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];connectable=0;strokeColor=#D6B656;" vertex="1" parent="c152"><mxGeometry x="0.0" y="32.0" width="132.0" height="8.0" as="geometry"/></mxCell><mxCell id="c155" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;u&gt;+ percentOf(int, int): int&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ format(int): String&lt;/u&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c152"><mxGeometry x="0.0" y="36.0" width="132.0" height="38.0" as="geometry"/></mxCell><mxCell id="c156" value="&lt;b&gt;Polymorphism (interfaces)&lt;/b&gt;&lt;br&gt;GameController holds only the&lt;br&gt;ManagerInput and GameDisplay&lt;br&gt;interfaces. ConsoleUI implements&lt;br&gt;both for live play and ScriptedInput&lt;br&gt;implements ManagerInput to replay a&lt;br&gt;recorded run, so the same&lt;br&gt;input.askCommand(...) call reaches&lt;br&gt;either one." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1490.0" y="130.0" width="196.0" height="133.0" as="geometry"/></mxCell><mxCell id="c157" value="&lt;b&gt;Polymorphism&lt;/b&gt;&lt;br&gt;createOrderFor(...) prices every order through calls that are&lt;br&gt;bound at run time: customer.chooseFrom(menu),&lt;br&gt;item.getPriceCents(), customer.applyCustomerDiscount(...)&lt;br&gt;and promotion.applyTo(...). It never tests which subclass it&lt;br&gt;holds." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="260.0" y="1440.0" width="300.0" height="94.0" as="geometry"/></mxCell><mxCell id="c158" value="&lt;b&gt;Polymorphism&lt;/b&gt;&lt;br&gt;performSeating(SeatingStaff, Customer) is one routine for both roles:&lt;br&gt;staff.seat(customer, table) runs Host.seat or Waiter.seat, whichever object is&lt;br&gt;passed in." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40.0" y="770.0" width="380.0" height="68.0" as="geometry"/></mxCell><mxCell id="c159" value="&lt;b&gt;Encapsulation&lt;/b&gt;&lt;br&gt;Every field is private and there are no setters.&lt;br&gt;lockedPriceCents is final, so a promotion that starts later&lt;br&gt;cannot reprice the order. status changes only through&lt;br&gt;advancePreparation, markServed, markPaid and cancel,&lt;br&gt;and each one throws IllegalStateException when called&lt;br&gt;out of order." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="380.0" y="2560.0" width="280.0" height="107.0" as="geometry"/></mxCell><mxCell id="c160" value="&lt;b&gt;Composition (Composite pattern)&lt;/b&gt;&lt;br&gt;A ComboMeal is a MenuItem made of two MenuItems:&lt;br&gt;its price is 90% of theirs and its prep units and portions&lt;br&gt;are their sums, so Order and Menu treat both kinds&lt;br&gt;alike." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="700.0" y="2470.0" width="270.0" height="81.0" as="geometry"/></mxCell><mxCell id="c161" value="&lt;b&gt;Composition&lt;/b&gt;&lt;br&gt;Restaurant creates its Tables and its WaitingQueue in its own&lt;br&gt;constructor, so they exist only inside it. The Menu and the four&lt;br&gt;staff members are created in RestaurantRush and passed in,&lt;br&gt;which makes those aggregations." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1700.0" y="1780.0" width="300.0" height="81.0" as="geometry"/></mxCell><mxCell id="c162" value="&lt;b&gt;Polymorphism&lt;/b&gt;&lt;br&gt;Customer.applyWaitingLoss() calls the abstract&lt;br&gt;getSatisfactionLossPerWaitingTurn(), so each&lt;br&gt;subclass loses its own amount per turn (8, 5,&lt;br&gt;12). CriticCustomer also overrides&lt;br&gt;chooseFrom(Menu) and satisfactionToRecord()." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1800.0" y="2705.0" width="240.0" height="94.0" as="geometry"/></mxCell><mxCell id="c163" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;exitX=0.4959;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.0933;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c4" target="c26"><mxGeometry relative="1" as="geometry"><mxPoint x="100.0" y="204.0" as="sourcePoint"/><mxPoint x="442.0" y="370.0" as="targetPoint"/><Array as="points"><mxPoint x="100.0" y="370.0"/></Array></mxGeometry></mxCell><mxCell id="c164" value="&lt;i&gt;«create»&lt;/i&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resi