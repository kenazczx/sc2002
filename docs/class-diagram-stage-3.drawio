ign=top;horizontal=1;startSize=26;collapsible=0;container=1;marginBottom=0;whiteSpace=nowrap;fillColor=#FFF2CC;swimlaneFillColor=#FFFFFF;swimlaneLine=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;strokeColor=#D79B00;strokeWidth=2.6;" vertex="1" parent="1"><mxGeometry x="272.0" y="3064.0" width="298.0" height="130.0" as="geometry"/></mxCell><mxCell id="c176" value="" style="shape=umlEntity;html=1;fillColor=none;strokeColor=#333333;strokeWidth=1.2;connectable=0;" vertex="1" parent="c175"><mxGeometry x="280.0" y="7.0" width="12.0" height="12.0" as="geometry"/></mxCell><mxCell id="c177" value="&lt;div style=&quot;line-height:14px&quot;&gt;- priceCents: int&lt;br&gt;- prepUnits: int&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c175"><mxGeometry x="0.0" y="26.0" width="298.0" height="38.0" as="geometry"/></mxCell><mxCell id="c178" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];connectable=0;strokeColor=#D6B656;" vertex="1" parent="c175"><mxGeometry x="0.0" y="60.0" width="298.0" height="8.0" as="geometry"/></mxCell><mxCell id="c179" value="&lt;div style=&quot;line-height:14px&quot;&gt;+ SingleDish(name: String, priceCents: int, prepUnits: int)&lt;br&gt;+ getPriceCents(): int&lt;br&gt;+ getPrepUnits(): int&lt;br&gt;+ getPortions(): int&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c175"><mxGeometry x="0.0" y="64.0" width="298.0" height="66.0" as="geometry"/></mxCell><mxCell id="c180" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«enumeration»&lt;/span&gt;&lt;br&gt;OrderStatus" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=38;collapsible=0;container=1;marginBottom=0;whiteSpace=nowrap;fillColor=#FFF2CC;swimlaneFillColor=#FFFFFF;swimlaneLine=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1039.0" y="3374.0" width="117.0" height="132.0" as="geometry"/></mxCell><mxCell id="c181" value="" style="shape=umlEntity;html=1;fillColor=none;strokeColor=#333333;strokeWidth=1.2;connectable=0;" vertex="1" parent="c180"><mxGeometry x="99.0" y="13.0" width="12.0" height="12.0" as="geometry"/></mxCell><mxCell id="c182" value="&lt;div style=&quot;line-height:14px&quot;&gt;PLACED&lt;br&gt;PREPARING&lt;br&gt;READY&lt;br&gt;SERVED&lt;br&gt;PAID&lt;br&gt;CANCELLED&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c180"><mxGeometry x="0.0" y="38.0" width="117.0" height="94.0" as="geometry"/></mxCell><mxCell id="c183" value="RegularCustomer" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=26;collapsible=0;container=1;marginBottom=0;whiteSpace=nowrap;fillColor=#FFF2CC;swimlaneFillColor=#FFFFFF;swimlaneLine=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;strokeColor=#D79B00;strokeWidth=2.2;dashed=1;dashPattern=7 4;" vertex="1" parent="1"><mxGeometry x="912.0" y="3620.0" width="365.0" height="116.0" as="geometry"/></mxCell><mxCell id="c184" value="" style="shape=umlEntity;html=1;fillColor=none;strokeColor=#333333;strokeWidth=1.2;connectable=0;" vertex="1" parent="c183"><mxGeometry x="347.0" y="7.0" width="12.0" height="12.0" as="geometry"/></mxCell><mxCell id="c185" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;u&gt;+ SATISFACTION_LOSS: int = 8&lt;/u&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c183"><mxGeometry x="0.0" y="26.0" width="365.0" height="24.0" as="geometry"/></mxCell><mxCell id="c186" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];connectable=0;strokeColor=#D6B656;" vertex="1" parent="c183"><mxGeometry x="0.0" y="46.0" width="365.0" height="8.0" as="geometry"/></mxCell><mxCell id="c187" value="&lt;div style=&quot;line-height:14px&quot;&gt;+ RegularCustomer(id: int, name: String, arrivalTurn: int, tasteIndex: int,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;appetite: Appetite)&lt;br&gt;+ getSatisfactionLossPerWaitingTurn(): int&lt;br&gt;+ getTypeLabel(): String&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c183"><mxGeometry x="0.0" y="50.0" width="365.0" height="66.0" as="geometry"/></mxCell><mxCell id="c188" value="VIPCustomer" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=26;collapsible=0;container=1;marginBottom=0;whiteSpace=nowrap;fillColor=#FFF2CC;swimlaneFillColor=#FFFFFF;swimlaneLine=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;strokeColor=#D79B00;strokeWidth=2.2;dashed=1;dashPattern=7 4;" vertex="1" parent="1"><mxGeometry x="1327.0" y="3620.0" width="345.0" height="144.0" as="geometry"/></mxCell><mxCell id="c189" value="" style="shape=umlEntity;html=1;fillColor=none;strokeColor=#333333;strokeWidth=1.2;connectable=0;" vertex="1" parent="c188"><mxGeometry x="327.0" y="7.0" width="12.0" height="12.0" as="geometry"/></mxCell><mxCell id="c190" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;u&gt;+ SATISFACTION_LOSS: int = 5&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ BILL_PERCENT: int = 90&lt;/u&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c188"><mxGeometry x="0.0" y="26.0" width="345.0" height="38.0" as="geometry"/></mxCell><mxCell id="c191" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];connectable=0;strokeColor=#D6B656;" vertex="1" parent="c188"><mxGeometry x="0.0" y="60.0" width="345.0" height="8.0" as="geometry"/></mxCell><mxCell id="c192" value="&lt;div style=&quot;line-height:14px&quot;&gt;+ VIPCustomer(id: int, name: String, arrivalTurn: int, tasteIndex: int,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;appetite: Appetite)&lt;br&gt;+ getSatisfactionLossPerWaitingTurn(): int&lt;br&gt;+ getTypeLabel(): String&lt;br&gt;+ applyCustomerDiscount(grossCents: int): int&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c188"><mxGeometry x="0.0" y="64.0" width="345.0" height="80.0" as="geometry"/></mxCell><mxCell id="c193" value="CriticCustomer" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=26;collapsible=0;container=1;marginBottom=0;whiteSpace=nowrap;fillColor=#FFF2CC;swimlaneFillColor=#FFFFFF;swimlaneLine=1;fontSize=12;fontFamily=Helvetica;fontColor=#333333;strokeColor=#D79B00;strokeWidth=2.2;dashed=1;dashPattern=7 4;" vertex="1" parent="1"><mxGeometry x="1722.0" y="3620.0" width="352.0" height="172.0" as="geometry"/></mxCell><mxCell id="c194" value="" style="shape=umlEntity;html=1;fillColor=none;strokeColor=#333333;strokeWidth=1.2;connectable=0;" vertex="1" parent="c193"><mxGeometry x="334.0" y="7.0" width="12.0" height="12.0" as="geometry"/></mxCell><mxCell id="c195" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;u&gt;+ SATISFACTION_LOSS: int = 12&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ PROMPT_SERVICE_TURNS: int = 3&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ REVIEW_SWING: int = 10&lt;/u&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c193"><mxGeometry x="0.0" y="26.0" width="352.0" height="52.0" as="geometry"/></mxCell><mxCell id="c196" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];connectable=0;strokeColor=#D6B656;" vertex="1" parent="c193"><mxGeometry x="0.0" y="74.0" width="352.0" height="8.0" as="geometry"/></mxCell><mxCell id="c197" value="&lt;div style=&quot;line-height:14px&quot;&gt;+ CriticCustomer(id: int, name: String, arrivalTurn: int, tasteIndex: int,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;appetite: Appetite)&lt;br&gt;+ getSatisfactionLossPerWaitingTurn(): int&lt;br&gt;+ getTypeLabel(): String&lt;br&gt;+ chooseFrom(menu: Menu): MenuItem&lt;br&gt;+ satisfactionToRecord(): int&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingRight=4;spacingTop=5;overflow=visible;rotatable=0;points=[];connectable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="c193"><mxGeometry x="0.0" y="78.0" width="352.0" height="94.0" as="geometry"/></mxCell><mxCell id="c198" value="&lt;b&gt;Polymorphism (interfaces)&lt;/b&gt;&lt;br&gt;GameController holds only the&lt;br&gt;ManagerInput and GameDisplay&lt;br&gt;interfaces. ConsoleUI implements&lt;br&gt;both for live play and ScriptedInput&lt;br&gt;implements ManagerInput to replay a&lt;br&gt;recorded run, so the same&lt;br&gt;input.askCommand(...) and&lt;br&gt;input.askActivateHappyHour() calls&lt;br&gt;reach either one." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1730.0" y="130.0" width="196.0" height="146.0" as="geometry"/></mxCell><mxCell id="c199" value="&lt;b&gt;Polymorphism (interface)&lt;/b&gt;&lt;br&gt;GameController always holds a Promotion: a&lt;br&gt;NoPromotion until Happy Hour is switched on,&lt;br&gt;and a new NoPromotion once it ends.&lt;br&gt;applyTo(price) and&lt;br&gt;getGoodwillPerActiveTurn() are bound at run&lt;br&gt;time, so no code tests which promotion is&lt;br&gt;running or checks for null. NoPromotion is the&lt;br&gt;Null Object pattern." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40.0" y="1046.0" width="230.0" height="133.0" as="geometry"/></mxCell><mxCell id="c200" value="&lt;b&gt;Polymorphism&lt;/b&gt;&lt;br&gt;createOrderFor(...) never tests a type:&lt;br&gt;customer.chooseFrom(menu), item.getPriceCents(),&lt;br&gt;customer.applyCustomerDiscount(price) and&lt;br&gt;promotion.applyTo(price) are bound at run time, so the same&lt;br&gt;four calls price a combo or a single dish, for any customer, with&lt;br&gt;or without Happy Hour." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40.0" y="1514.0" width="310.0" height="107.0" as="geometry"/></mxCell><mxCell id="c201" value="&lt;b&gt;Polymorphism (interface)&lt;/b&gt;&lt;br&gt;GameController.performSeating(SeatingStaff,&lt;br&gt;Customer) is one routine for both roles:&lt;br&gt;staff.seat(customer, table) runs Host.seat&lt;br&gt;or Waiter.seat, whichever object is passed&lt;br&gt;in." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="780.0" y="1886.0" width="214.0" height="94.0" as="geometry"/></mxCell><mxCell id="c202" value="&lt;b&gt;Composition&lt;/b&gt;&lt;br&gt;Restaurant creates its Tables (from tableCount) and its&lt;br&gt;WaitingQueue itself, so they exist only inside it: filled&lt;br&gt;diamonds. The Menu and the four staff members are created&lt;br&gt;in RestaurantRush and passed to the constructor, which&lt;br&gt;makes those aggregations: hollow diamonds." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1439.0" y="2366.0" width="300.0" height="94.0" as="geometry"/></mxCell><mxCell id="c203" value="&lt;b&gt;Composite pattern&lt;/b&gt;&lt;br&gt;ComboMeal is a MenuItem made of two MenuItems: its&lt;br&gt;price is 90% of theirs and its preparation units and&lt;br&gt;portions are their sums, so Menu and Order use a combo&lt;br&gt;exactly like a single dish. The parts are dishes the menu&lt;br&gt;already lists, so the combo does not own them: hollow&lt;br&gt;diamonds." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="620.0" y="3276.0" width="280.0" height="107.0" as="geometry"/></mxCell><mxCell id="c204" value="&lt;b&gt;Encapsulation&lt;/b&gt;&lt;br&gt;Every field is private and there are no setters.&lt;br&gt;lockedPriceCents is final: the price is fixed when the order&lt;br&gt;is taken, so a promotion that starts or ends later cannot&lt;br&gt;change it. status changes only through&lt;br&gt;advancePreparation, markServed, markPaid and cancel,&lt;br&gt;and each one throws IllegalStateException when called out&lt;br&gt;of order." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720.0" y="3423.0" width="290.0" height="120.0" as="geometry"/></mxCell><mxCell id="c205" value="&lt;b&gt;Polymorphism&lt;/b&gt;&lt;br&gt;Customer is abstract. applyWaitingLoss() calls the abstract&lt;br&gt;getSatisfactionLossPerWaitingTurn(), so each subclass loses&lt;br&gt;its own amount per turn (Regular 8, VIP 5, Critic 12).&lt;br&gt;VIPCustomer overrides applyCustomerDiscount(int) for its&lt;br&gt;10% off, and CriticCustomer overrides chooseFrom(Menu)&lt;br&gt;and satisfactionToRecord()." style="shape=note;html=1;whiteSpace=wrap;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFDF5;strokeColor=#888888;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2114.0" y="3620.0" width="300.0" height="107.0" as="geometry"/></mxCell><mxCell id="c206" value="" style="edgeStyle=orthogonalEdgeStyle;rounde