s="geometry"/></mxCell><mxCell id="c399" value="RestaurantRush (package app) only creates the objects and starts" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="321.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c400" value="the game, so it has no stereotype." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="334.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c401" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#D79B00;strokeWidth=2.6;" vertex="1" parent="1"><mxGeometry x="1978.0" y="349.0" width="22.0" height="12.0" as="geometry"/></mxCell><mxCell id="c402" value="orange border: class added in stage 3" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2006.0" y="348.0" width="280.0" height="14.0" as="geometry"/></mxCell><mxCell id="c403" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#D79B00;strokeWidth=2.2;dashed=1;dashPattern=4 2;" vertex="1" parent="1"><mxGeometry x="1978.0" y="363.0" width="22.0" height="12.0" as="geometry"/></mxCell><mxCell id="c404" value="dashed orange border: class changed in stage 3" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2006.0" y="362.0" width="280.0" height="14.0" as="geometry"/></mxCell><mxCell id="c405" value="&lt;b&gt;Members&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1974.0" y="386.0" width="314.0" height="15.0" as="geometry"/></mxCell><mxCell id="c406" value="Visibility: + public, - private, # protected, ~ package. Underlined:" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="400.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c407" value="static. Italic with {abstract}: abstract." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="413.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c408" value="Attribute: name: type = initial value" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="426.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c409" value="Operation: name(parameter: type): return type" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="439.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c410" value="Constructor: the class name, and no return type" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="452.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c411" value="Every field, constructor and method declared in the code is listed." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="465.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c412" value="{...} after an attribute is a constraint the class keeps." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="478.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c413" value="Role names on the lines are the Java field names. {ordered}: the field" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="491.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c414" value="is a List, so it keeps its order." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="504.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c415" value="&lt;b&gt;Dependencies left out to keep lines apart&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1974.0" y="528.0" width="314.0" height="15.0" as="geometry"/></mxCell><mxCell id="c416" value="RestaurantRush creates and wires every object; only its «instantiate»" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="542.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c417" value="of GameController is drawn." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="555.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c418" value="ArrivalSchedule creates the RegularCustomer, VIPCustomer and" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="568.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c419" value="CriticCustomer objects that it returns as Customer, each with an" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="581.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c420" value="Appetite." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="594.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c421" value="Money (static helpers for cents) is used by MenuItem, ComboMeal," style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="607.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c422" value="Order, VIPCustomer, HappyHourPromotion, GameController and" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="620.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c423" value="ConsoleUI." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="633.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c424" value="GameController and ConsoleUI read the HappyHourPromotion" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="646.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c425" value="constants to describe Happy Hour." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="659.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c426" value="Any other parameter or return type can be read in the operation" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="672.0" width="312.0" height="14.0" as="geometry"/></mxCell><mxCell id="c427" value="signatures." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1976.0" y="685.0" width="312.0" height="14.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>